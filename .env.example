# Required
BOT_TOKEN=your_bot_token_here
CLIENT_ID=1523811499766976723

# Dashboard (required for web dashboard)
CLIENT_SECRET=your_client_secret_from_oauth2_tab
BASE_URL=https://spamtrap.help
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Recommended in production (Railway): enables secure cookies + HTTPS enforcement
NODE_ENV=production

# Optional: guild ID for instant command registration (testing only)
# GUILD_ID=

# Optional: Railway volume path
# DATABASE_PATH=/data/db.json

# Optional: your Discord user id. Required to use /spamtrap servers (lists
# every server the bot is in). Leave unset to disable that command entirely.
# BOT_OWNER_ID=

# Server protection: member events (join-based raid detection only).
# Keep this false unless you have FIRST enabled "Server Members Intent" under
# Bot -> Privileged Gateway Intents in the Discord Developer Portal (and, once
# the bot is in 100+ servers, received Discord's approval for it). Setting it
# to true requests the privileged intent at login; if the portal toggle is
# off, Discord refuses the login and the bot exits with a [FATAL] message.
# Every other protection works with the default intents.
ENABLE_MEMBER_EVENTS=false
